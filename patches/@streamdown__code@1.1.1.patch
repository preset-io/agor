+import { bundledLanguagesInfo, bundledLanguages, createHighlighter } from 'shiki';
+import { createJavaScriptRegexEngine } from 'shiki/engine/javascript';
+
+const engine = createJavaScriptRegexEngine({ forgiving: true });
+const aliases = Object.fromEntries(bundledLanguagesInfo.flatMap(info =>
+  (info.aliases ?? []).map(alias => [alias, info.id])));
+const languages = new Set(Object.keys(bundledLanguages));
+const normalize = language => {
+  const id = language.trim().toLowerCase();
+  return aliases[id] || id;
+};
+
+// Agor patch: one browser-realm budget across ALL plugin instances, not one
+// unbounded result Map per module (or a fresh budget per mounted consumer).
+// These are retention/admission limits, NOT an absolute JS heap-byte cap.
+// Grammar/theme/engine state and live consumers/in-flight work are separate.
+const MAX_ENTRIES = 32;
+const MAX_WEIGHT = 4 * 1024 * 1024;
+const MAX_CODE_LENGTH = 64 * 1024;
+const results = new Map();
+const pending = new Map();
+let retainedWeight = 0;
+let generation = 0;
+
+// Full source participates in equality. The upstream first/last-100-character
+// shortcut aliases same-length edits in the middle of a fence.
+const themeIds = new WeakMap();
+let nextThemeId = 0;
+const themeId = theme => {
+  if (typeof theme === 'string') return theme;
+  let id = themeIds.get(theme);
+  if (!id) {
+    id = `agor-custom-${++nextThemeId}`;
+    themeIds.set(theme, id);
+  }
+  return id;
+};
+const highlighters = new Map();
+function getHighlighter(language, themes, names) {
+  const key = JSON.stringify([language, ...names]);
+  let promise = highlighters.get(key);
+  if (!promise) {
+    promise = createHighlighter({
+      themes: themes.map((theme, i) => typeof theme === 'string' ? theme : { ...theme, name: names[i] }),
+      langs: [language],
+      engine,
+    });
+    highlighters.set(key, promise);
+    // A failed lazy import must not poison subsequent attempts.
+    promise.catch(() => { if (highlighters.get(key) === promise) highlighters.delete(key); });
+  }
+  return promise;
+}
+
+function remember(key, result, codeLength) {
+  if (codeLength > MAX_CODE_LENGTH) return;
+  // Linear, allocation-light estimate: source/key + arrays + token objects +
+  // string/style payloads. Stop at the budget; never serialize the token tree.
+  let weight = key.length * 2 + 256;
+  for (const value of Object.values(result)) {
+    if (typeof value === 'string') weight += value.length * 2;
+  }
+  for (const line of result.tokens) {
+    weight += 64;
+    for (const token of line) {
+      weight += 256;
+      for (const value of Object.values(token)) {
+        if (typeof value === 'string') weight += value.length * 2;
+      }
+      for (const field of [token.htmlStyle, token.htmlAttrs]) {
+        if (field) for (const [name, value] of Object.entries(field)) {
+          weight += 32 + name.length * 2 + String(value).length * 2;
+        }
+      }
+      if (weight > MAX_WEIGHT) return;
+    }
+    if (weight > MAX_WEIGHT) return;
+  }
+  if (weight > MAX_WEIGHT) return;
+  while (results.size >= MAX_ENTRIES || retainedWeight + weight > MAX_WEIGHT) {
+    const oldest = results.keys().next().value;
+    retainedWeight -= results.get(oldest).weight;
+    results.delete(oldest);
+  }
+  results.set(key, { result, weight });
+  retainedWeight += weight;
+}
+
+// Also invalidates in-flight delivery/admission. It intentionally leaves Shiki's
+// grammar/theme loaders alone: they contain no highlighted document results.
+export function clearHighlightCache() {
+  generation++;
+  results.clear();
+  for (const subscribers of pending.values()) subscribers.clear();
+  pending.clear();
+  retainedWeight = 0;
+}
+
+export function createCodePlugin(options = {}) {
+  const themes = options.themes ?? ['github-light', 'github-dark'];
+  return {
+    name: 'shiki',
+    type: 'code-highlighter',
+    supportsLanguage: language => languages.has(normalize(language)),
+    getSupportedLanguages: () => Array.from(languages),
+    getThemes: () => themes,
+    highlight({ code, language, themes }, callback) {
+      const normalized = normalize(language);
+      const names = themes.map(themeId);
+      const key = `${JSON.stringify([normalized, ...names])}:${code}`;
+      // No document results or subscribers shared between server requests.
+      const browser = typeof window !== 'undefined';
+      const hit = browser ? results.get(key) : undefined;
+      if (hit) {
+        results.delete(key);
+        results.set(key, hit);
+        return hit.result;
+      }
+      const jobs = browser ? pending : new Map();
+      let job = jobs.get(key);
+      if (job) {
+        if (callback) job.add(callback);
+        return null;
+      }
+      job = new Set(callback ? [callback] : []);
+      jobs.set(key, job);
+      const startedGeneration = generation;
+      const current = () => generation === startedGeneration && jobs.get(key) === job;
+      const effectiveLanguage = languages.has(normalized) ? normalized : 'text';
+      // Promise boundary handles synchronous loader failures as well as rejects.
+      Promise.resolve().then(() => getHighlighter(effectiveLanguage, themes, names)).then(highlighter => {
+        if (!current()) return;
+        const lang = highlighter.getLoadedLanguages().includes(normalized) ? normalized : 'text';
+        const result = highlighter.codeToTokens(code, { lang, themes: { light: names[0], dark: names[1] } });
+        if (browser) remember(key, result, code.length);
+        // Delete before delivery so throwing/reentrant subscribers cannot strand
+        // this job or delete a newer request for an uncached oversized result.
+        jobs.delete(key);
+        for (const subscriber of job) {
+          if (generation !== startedGeneration) break;
+          try { subscriber(result); }
+          catch (error) { console.error('[Streamdown Code] Subscriber failed:', error); }
+        }
+      }).catch(error => {
+        if (current()) jobs.delete(key);
+        console.error('[Streamdown Code] Failed to highlight code:', error);
+      });
+      return null;
+    },
+  };
+}
+
+export const code = createCodePlugin();
