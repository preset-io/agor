{
  "name": "@agor/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "test:blog": "vitest run lib/blogPublication.test.ts",
    "dev": "next dev -p 3001",
    "build": "next build --turbopack && pnpm run build:post",
    "build:webpack": "next build && pnpm run build:post",
    "build:post": "next-sitemap --config next-sitemap.config.cjs && pnpm run build:search",
    "start": "serve out --listen 3000",
    "serve": "pnpm run build && node scripts/serve-and-open.mjs",
    "preview": "node scripts/serve-and-open.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:brand-assets": "tsx scripts/validate-brand-assets.ts",
    "validate:social-metadata": "tsx scripts/validate-social-metadata.ts",
    "validate:analytics": "tsx --test scripts/validate-analytics.test.ts && tsx scripts/validate-analytics.ts",
    "build:search": "pagefind --site out --output-path out/_pagefind && rm -rf public/_pagefind && cp -R out/_pagefind public/_pagefind"
  },
  "dependencies": {
    "@scalar/api-reference-react": "0.9.67",
    "@theguild/remark-mermaid": "^0.3.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.46.0",
    "next": "^15.5.27",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "~19.3.0",
    "next-sitemap": "^4.2.3",
    "pagefind": "^1.5.2",
    "serve": "^14.2.6",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  }
}
