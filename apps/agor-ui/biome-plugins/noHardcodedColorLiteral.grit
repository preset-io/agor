engine biome(1.0)
language js(typescript, jsx)

// Catch standalone color values in palettes and constants even when the
// surrounding property has a domain-specific name such as `dark` or `idle`.
// Requiring the entire string to be a color avoids matching issue references,
// URLs, IDs, and hashes that merely contain a `#123`-shaped substring.
JsStringLiteralExpression() as $literal where {
  $literal <: r"(?i)^[\"'](?:#(?:[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})|(?:rgba?|hsla?|oklch|oklab|color)\([^\"']*\))[\"']$",
  register_diagnostic(span=$literal, message="Use an Ant Design component or theme token instead of a hard-coded color literal. Intentional palettes require a documented plugin suppression.", severity="error")
}
