engine biome(1.0)
language js(typescript, jsx)

// Catch unambiguous color syntax anywhere inside a string, not just when the
// color is the entire value. This covers conditional values, gradients,
// shadows, generated HTML/CSS, and template strings. Three-digit hex and
// named colors are handled by the context-aware property rule because values
// such as `repo#123` are common and are not necessarily colors.
or {
  JsStringLiteralExpression(),
  JsTemplateExpression()
} as $literal where {
  $literal <: r"(?is)^[\"'`](?:#(?:[0-9a-f]{8}|[0-9a-f]{6}|[0-9a-f]{4})|.*(?:(?:[^0-9a-z_/-])#(?:[0-9a-f]{8}|[0-9a-f]{6}|[0-9a-f]{4})|(?:rgba?|hsla?|oklch|oklab|color)\([^\"'`]*\)|(?:[ :,()]#[0-9a-f]{3}|#[0-9a-f]{3}[ :,()%]))).*[\"'`]$",
  register_diagnostic(span=$literal, message="Use an Ant Design component or theme token instead of a hard-coded color literal. Intentional palettes require a documented plugin suppression.", severity="error")
}
