{
  "name": "@agor/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./uploads-maintenance": {
      "types": "./dist/uploads-maintenance.d.ts",
      "import": "./dist/uploads-maintenance.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationMap --noEmit false --incremental false && node scripts/stamp-build-info.mjs",
    "dev": "pnpm --filter @agor/core build && pnpm --filter @agor/agentic-tool-opencode build && pnpm --filter @agor/agentic-tools build && concurrently -k -n core,opencode,agentic-tools,daemon -c cyan,blue,magenta,green \"pnpm --filter @agor/core dev\" \"pnpm --filter @agor/agentic-tool-opencode dev\" \"pnpm --filter @agor/agentic-tools dev\" \"./node_modules/.bin/tsx watch --clear-screen=false --ignore 'node_modules/**' src/main.ts\"",
    "dev:daemon-only": "tsx watch --clear-screen=false --ignore 'node_modules/**' src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agor/agentic-tool-opencode": "workspace:*",
    "@agor/agentic-tools": "workspace:*",
    "@agor/core": "workspace:*",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "diff": "^8.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.0",
    "express-rate-limit": "^8.6.2",
    "express-static-gzip": "^3.0.1",
    "feathers-swagger": "^3.0.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@anthropic-ai/sdk": "^0.109.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@cursor/sdk": "^1.0.26",
    "@github/copilot-sdk": "^0.2.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mdast": "^4.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "glob": "^11.0.3",
    "hot-shots": "^17.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "^8.5.1",
    "tsx": "4.23.11",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "hot-shots": "^17.1.0"
  },
  "peerDependenciesMeta": {
    "hot-shots": {
      "optional": true
    }
  }
}
