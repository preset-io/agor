{
  "name": "@agor/executor",
  "version": "0.1.0",
  "description": "Agor executor process - isolated execution environment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agor-executor": "./bin/agor-executor"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:opencode-runtime": "tsx scripts/opencode-managed-runtime-harness.mjs --module src/sdk-handlers/opencode/opencode-tool.ts --permission-module src/permissions/permission-service.ts --streaming-module src/handlers/sdk/base-executor.ts --containment-module ../../apps/agor-daemon/src/executor-tracking.ts",
    "test:opencode-auth": "tsx scripts/opencode-provider-auth-harness.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agor/core": "workspace:*",
    "@agor/git": "workspace:*",
    "@cursor/sdk": "^1.0.23",
    "@github/copilot-sdk": "^0.2.2",
    "@opencode-ai/sdk": "1.14.33",
    "diff": "^7.0.0",
    "node-pty": "^1.2.0-beta.12",
    "opencode-ai": "1.14.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^24.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "bin"
  ]
}
