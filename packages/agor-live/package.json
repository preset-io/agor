{
  "name": "agor-live",
  "version": "0.26.1",
  "description": "Team command center for all things agentic — shared canvas for coding agents and assistants on isolated git branches, with real-time multiplayer and an MCP surface agents drive themselves.",
  "type": "module",
  "bin": {
    "agor": "./bin/agor.js",
    "agor-daemon": "./bin/agor-daemon.js"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check:content": "node scripts/check-package-content.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "test": "node --test scripts/*.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "ai",
    "claude",
    "codex",
    "gemini",
    "multiplayer",
    "collaboration",
    "git",
    "workflow"
  ],
  "author": "Maxime Beauchemin <maximebeauchemin@gmail.com>",
  "license": "BUSL-1.1",
  "homepage": "https://agor.live",
  "repository": {
    "type": "git",
    "url": "https://github.com/preset-io/agor.git"
  },
  "bugs": {
    "url": "https://github.com/preset-io/agor/issues"
  },
  "dependencies": {
    "@agor-live/client": "workspace:*",
    "@agor/agentic-tool-opencode": "workspace:*",
    "@agor/agentic-tools": "workspace:*",
    "@agor/core": "workspace:*",
    "@agor/git": "workspace:*",
    "@anthropic-ai/sdk": "^0.109.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@feathersjs/authentication": "^5.0.46",
    "@feathersjs/authentication-client": "^5.0.46",
    "@feathersjs/authentication-local": "^5.0.46",
    "@feathersjs/errors": "^5.0.46",
    "@feathersjs/express": "^5.0.46",
    "@feathersjs/feathers": "^5.0.46",
    "@feathersjs/rest-client": "^5.0.46",
    "@feathersjs/schema": "^5.0.46",
    "@feathersjs/socketio": "^5.0.46",
    "@feathersjs/socketio-client": "^5.0.46",
    "@feathersjs/typebox": "^5.0.46",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@oclif/core": "^4.13.3",
    "@oclif/plugin-help": "^6.2.56",
    "@slack/socket-mode": "^2.0.7",
    "@slack/types": "^2.22.0",
    "@slack/web-api": "^7.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cron-parser": "^5.7.0",
    "cronstrue": "^3.24.0",
    "diff": "^8.0.3",
    "discord-api-types": "^0.38.53",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "emojibase-data": "^17.0.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.6.2",
    "express-static-gzip": "^3.0.1",
    "feathers-swagger": "^3.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^12.10.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pnpm": "11.17.0",
    "postgres": "^3.4.9",
    "proper-lockfile": "4.1.2",
    "simple-git": "^3.36.0",
    "slackify-markdown": "^5.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  },
  "peerDependencies": {
    "hot-shots": "^17.1.0"
  },
  "peerDependenciesMeta": {
    "hot-shots": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@agor/agentic-tool-opencode",
    "@agor/agentic-tools",
    "@agor/core",
    "@agor/git"
  ],
  "oclif": {
    "bin": "agor",
    "dirname": "agor",
    "commands": "./dist/cli/commands",
    "topicSeparator": " ",
    "helpClass": "./dist/cli/lib/help.js",
    "hooks": {
      "command_not_found": "./dist/cli/hooks/command-not-found.js"
    }
  }
}
