{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "pnpm-lock.yaml"],
  "globalPassThroughEnv": [
    "AGOR_DB_DIALECT",
    "AGOR_POSTGRES_TEST_CONCURRENCY",
    "AGOR_POSTGRES_TEST_RUN_ID",
    "AGOR_TEST_POSTGRES_ADMIN_URL",
    "AGOR_TEST_POSTGRES_URL",
    "BIOME_BIN",
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "@agor/daemon#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"],
      "env": ["AGOR_BUILD_SHA", "AGOR_BUILT_AT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@agor/executor#test": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    }
  }
}
