#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/agor-nat-bootstrap.log) 2>&1
dnf install -y nftables
cat > /etc/sysctl.d/90-agor-nat.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
SYSCTL
sysctl --system
mkdir -p /etc/agor-nat
cat > /etc/agor-nat/rules.nft <<'NFT'
table ip agor_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr ${source_cidr} counter masquerade
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related counter accept
    ip saddr ${source_cidr} counter accept
  }
}
NFT
cat > /etc/systemd/system/agor-nat.service <<'UNIT'
[Unit]
Description=Agor EC2 NAT forwarding
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table ip agor_nat
ExecStart=/usr/sbin/nft -f /etc/agor-nat/rules.nft
ExecStop=/usr/sbin/nft delete table ip agor_nat
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now agor-nat
echo AGOR_NAT_READY
